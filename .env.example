# Wedding Memory AR - Environment Configuration
# Copy this file to .env.local and update with your actual domain

# Production deployment domain
# For local development, leave this blank - it will use window.location
# For production, set this to your HTTPS domain
VITE_APP_URL=https://your-domain.com

# Optional: API endpoint (for future use)
# VITE_API_URL=https://api.your-domain.com
